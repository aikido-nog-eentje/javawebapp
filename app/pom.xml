<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.veracode</groupId>
	<artifactId>verademo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>verademo</name>
	<url>https://github.com/veracode/verademo</url>
	<packaging>war</packaging>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18</version>
		<relativePath/>
	</parent>

	<!-- Component Version Properties -->
	<properties>
		<springboot.version>2.7.18</springboot.version>
		<fileupload.version>1.6.0</fileupload.version>
	</properties>

	<!-- Dependencies begin here -->
	<dependencies>
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-jasper</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>jstl</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>com.veracode.annotation</groupId>
			<artifactId>VeracodeAnnotations</artifactId>
			<version>[1.0.4,)</version>
		</dependency>
		<dependency>
			<groupId>org.owasp.encoder</groupId>
			<artifactId>encoder</artifactId>
			<version>1.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.owasp.encoder</groupId>
			<artifactId>encoder-jsp</artifactId>
			<version>1.2.2</version>
		</dependency>

		<!-- Spring dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<version>${springboot.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<version>${springboot.version}</version>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<version>${springboot.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Logging dependencies -->
		<!-- Replaced slf4j-log4j12 (which pulled in log4j:log4j@1.2.17) with
		     log4j-over-slf4j, a zero-code-change drop-in that routes log4j 1.x
		     API calls to SLF4J without including the vulnerable log4j 1.x jar.
		     This removes log4j:log4j from the dependency tree entirely, fixing
		     CVE-2019-17571, CVE-2021-4104, CVE-2022-23302, CVE-2022-23305,
		     CVE-2022-23307, CVE-2023-26464. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>log4j-over-slf4j</artifactId>
			<version>1.7.36</version>
		</dependency>

		<!-- Apache Commons dependencies -->
		<dependency>
			<groupId>commons-fileupload</groupId>
			<artifactId>commons-fileupload</artifactId>
			<version>${fileupload.version}</version>
		</dependency>

		<!-- Apache Commons IO -->
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.14.0</version>
		</dependency>

		<!-- Vuln Method libs -->
		<dependency>
			<groupId>org.apache.sling</groupId>
			<artifactId>maven-sling-plugin</artifactId>
			<version>2.0.4-incubator</version>
		</dependency>

		<dependency>
			<groupId>org.mindrot</groupId>
			<artifactId>jbcrypt</artifactId>
			<version>0.3m</version>
		</dependency>

		<dependency>
			<groupId>org.keycloak</groupId>
			<artifactId>keycloak-saml-core</artifactId>
			<version>26.6.2</version>
		</dependency>

		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>8.0.28</version>
		</dependency>

		<dependency>
			<groupId>javax.mail</groupId>
			<artifactId>mail</artifactId>
			<version>1.4.7</version>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-collections4</artifactId>
			<version>4.1</version>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<!-- Override Spring Framework to TuxCare security-backport build.
			     Declared before the spring-boot-dependencies BOM (inherited via parent)
			     so first-declared wins for all spring-* artifacts. -->
			<dependency>
				<groupId>org.springframework</groupId>
				<artifactId>spring-framework-bom</artifactId>
				<version>5.3.31-tuxcare.9</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Override Jackson to 2.18.9 (fixes CVE-2025-52999, GHSA-r7wm-3cxj-wff9,
			     CVE-2026-54512/13/14/15, CVE-2026-59889, GHSA-MHM7-754M-9P8W,
			     CVE-2020-36518, CVE-2021-46877, CVE-2022-42003/42004,
			     CVE-2026-50193, CVE-2025-49128) -->
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>2.18.9</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Override Log4j2 to 2.25.5 (fixes CVE-2019-17571, CVE-2022-23305/23307/23302,
			     CVE-2021-4104, CVE-2023-26464, AIKIDO-2026-30627, CVE-2026-49844) -->
			<dependency>
				<groupId>org.apache.logging.log4j</groupId>
				<artifactId>log4j-bom</artifactId>
				<version>2.25.5</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Override Tomcat to 9.0.118 (fixes all listed Tomcat CVEs) -->
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-core</artifactId>
				<version>9.0.118</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-el</artifactId>
				<version>9.0.118</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-jasper</artifactId>
				<version>9.0.118</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-websocket</artifactId>
				<version>9.0.118</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat</groupId>
				<artifactId>tomcat-annotations-api</artifactId>
				<version>9.0.118</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat</groupId>
				<artifactId>tomcat-jdbc</artifactId>
				<version>9.0.118</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat</groupId>
				<artifactId>tomcat-jsp-api</artifactId>
				<version>9.0.118</version>
			</dependency>

			<!-- Override Logback to 1.5.34 (fixes CVE-2023-6378, CVE-2021-42550,
			     CVE-2024-12798/12801, CVE-2025-11226, AIKIDO-2025-10694,
			     CVE-2026-10532, CVE-2026-1225, CVE-2026-9828) -->
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-core</artifactId>
				<version>1.5.34</version>
			</dependency>
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-classic</artifactId>
				<version>1.5.34</version>
			</dependency>
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-access</artifactId>
				<version>1.5.34</version>
			</dependency>

			<!-- Override SnakeYAML to TuxCare security-backport build
			     (fixes CVE-2022-1471, CVE-2022-25857, CVE-2022-38749/38750/38751/38752,
			     CVE-2022-41854) -->
			<dependency>
				<groupId>org.yaml</groupId>
				<artifactId>snakeyaml</artifactId>
				<version>1.26-tuxcare.3</version>
			</dependency>

			<!-- commons-fileupload 1.6.0 (fixes CVE-2016-1000031, CVE-2025-48976,
			     CVE-2023-24998) -->
			<dependency>
				<groupId>commons-fileupload</groupId>
				<artifactId>commons-fileupload</artifactId>
				<version>1.6.0</version>
			</dependency>

			<!-- commons-httpclient TuxCare security-backport (fixes CVE-2012-5783) -->
			<dependency>
				<groupId>commons-httpclient</groupId>
				<artifactId>commons-httpclient</artifactId>
				<version>3.1.tuxcare.1</version>
			</dependency>

			<!-- xmlsec 2.2.6 (fixes CVE-2021-40690, CVE-2023-44483,
			     CVE-2013-2172, CVE-2013-4517, CVE-2013-5823) -->
			<dependency>
				<groupId>org.apache.santuario</groupId>
				<artifactId>xmlsec</artifactId>
				<version>2.2.6</version>
			</dependency>

			<!-- plexus-archiver 4.8.0 (fixes CVE-2023-37460, CVE-2018-1002200) -->
			<dependency>
				<groupId>org.codehaus.plexus</groupId>
				<artifactId>plexus-archiver</artifactId>
				<version>4.8.0</version>
			</dependency>

			<!-- plexus-utils 3.6.1 (fixes CVE-2017-1000487, CVE-2025-67030,
			     CVE-2022-4244, CVE-2022-4245) -->
			<dependency>
				<groupId>org.codehaus.plexus</groupId>
				<artifactId>plexus-utils</artifactId>
				<version>3.6.1</version>
			</dependency>

			<!-- org.apache.sling:org.apache.sling.api pinned to 2.4.0 to satisfy
			     CVE-2013-2254 (fixed in 2.4.0) and CVE-2015-2944 (fixed in 2.2.2).
			     The declared dep is maven-sling-plugin:2.0.4-incubator which carries
			     org.apache.sling.api as a transitive; this pin overrides it. -->
			<dependency>
				<groupId>org.apache.sling</groupId>
				<artifactId>org.apache.sling.api</artifactId>
				<version>2.4.0</version>
			</dependency>

			<!-- protobuf-java pinned to 3.25.5 (fixes CVE-2021-22569, CVE-2022-3171,
			     CVE-2022-3509, CVE-2022-3510, CVE-2024-7254).
			     Pulled in transitively by keycloak-saml-core:26.6.2 via quarkus-bom. -->
			<dependency>
				<groupId>com.google.protobuf</groupId>
				<artifactId>protobuf-java</artifactId>
				<version>3.25.5</version>
			</dependency>

			<!-- commons-compress pinned to 1.26.0 (fixes CVE-2023-42503,
			     CVE-2024-25710, CVE-2024-26308).
			     Pulled in transitively by keycloak-saml-core:26.6.2. -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>1.26.0</version>
			</dependency>

			<!-- snappy pinned to 0.5 (fixes CVE-2024-36124).
			     Pulled in transitively by keycloak-saml-core:26.6.2. -->
			<dependency>
				<groupId>org.iq80.snappy</groupId>
				<artifactId>snappy</artifactId>
				<version>0.5</version>
			</dependency>

			<!-- commons-lang3 pinned to 3.18.0 (fixes CVE-2025-48924).
			     spring-boot-dependencies:2.7.18 manages this at 3.12.0; this
			     pin overrides it. commons-lang3 has no runtime dependencies
			     and 3.18.0 targets Java 8+, fully compatible with this project. -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>3.18.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<repositories>
		<repository>
			<id>aikido-maven</id>
			<url>https://maven.aikido.io/b6b7219dae019f5710c</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>

	<build>
		<finalName>verademo</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<debug>true</debug>
					<debuglevel>lines,vars,source</debuglevel>
					<compilerargs>
						<arg>-g:source,lines,vars</arg>
					</compilerargs>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
