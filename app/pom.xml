<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.veracode</groupId>
	<artifactId>verademo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>verademo</name>
	<url>https://github.com/veracode/verademo</url>
	<packaging>war</packaging>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18-tuxcare.19</version>
		<relativePath/>
	</parent>

	<!-- Component Version Properties -->
	<properties>
		<springboot.version>2.7.18-tuxcare.19</springboot.version>
		<fileupload.version>1.6.0</fileupload.version>
		<!-- Override spring-boot-dependencies managed versions -->
		<spring-framework.version>5.3.31-tuxcare.9</spring-framework.version>
		<tomcat.version>9.0.118</tomcat.version>
		<logback.version>1.5.34</logback.version>
		<log4j2.version>2.25.5</log4j2.version>
		<snakeyaml.version>1.26-tuxcare.3</snakeyaml.version>
		<!-- commons-lang3: spring-boot-dependencies 2.7.18 manages 3.12.0, but
		     keycloak-saml-core 26.6.2 (via quarkus-bom) pulls in 3.14.0.
		     Pin to 3.18.0 to fix CVE-2025-48924. -->
		<commons-lang3.version>3.18.0</commons-lang3.version>
	</properties>

	<!-- Dependencies begin here -->
	<dependencies>
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-jasper</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>jstl</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>com.veracode.annotation</groupId>
			<artifactId>VeracodeAnnotations</artifactId>
			<version>[1.0.4,)</version>
		</dependency>
		<dependency>
			<groupId>org.owasp.encoder</groupId>
			<artifactId>encoder</artifactId>
			<version>1.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.owasp.encoder</groupId>
			<artifactId>encoder-jsp</artifactId>
			<version>1.2.2</version>
		</dependency>

		<!-- Spring dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Logging dependencies -->
		<!-- Replaced slf4j-log4j12 (which pulls in log4j:log4j 1.x) with log4j-over-slf4j,
		     which routes log4j 1.x API calls to SLF4J without placing the vulnerable
		     log4j 1.x jar on the classpath. Fixes CVE-2019-17571, CVE-2021-4104,
		     CVE-2022-23302, CVE-2022-23305, CVE-2022-23307, CVE-2023-26464. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>log4j-over-slf4j</artifactId>
			<version>1.7.36</version>
		</dependency>

		<!-- Apache Commons dependencies -->
		<dependency>
			<groupId>commons-fileupload</groupId>
			<artifactId>commons-fileupload</artifactId>
			<version>${fileupload.version}</version>
		</dependency>

		<!-- Apache Commons IO -->
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.14.0</version>
		</dependency>

		<!-- Vuln Method libs -->
		<dependency>
			<groupId>org.apache.sling</groupId>
			<artifactId>maven-sling-plugin</artifactId>
			<version>2.0.4-incubator</version>
		</dependency>

		<dependency>
			<groupId>org.mindrot</groupId>
			<artifactId>jbcrypt</artifactId>
			<version>0.3m</version>
		</dependency>

		<dependency>
			<groupId>org.keycloak</groupId>
			<artifactId>keycloak-saml-core</artifactId>
			<version>26.6.2</version>
		</dependency>

		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>8.0.28</version>
		</dependency>

		<dependency>
			<groupId>javax.mail</groupId>
			<artifactId>mail</artifactId>
			<version>1.4.7</version>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-collections4</artifactId>
			<version>4.1</version>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<!-- TuxCare Spring Framework BOM — overrides spring-boot-dependencies spring-framework-bom import -->
			<dependency>
				<groupId>org.springframework</groupId>
				<artifactId>spring-framework-bom</artifactId>
				<version>5.3.31-tuxcare.9</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Jackson overrides (jackson-bom in spring-boot-dependencies 2.7.18 is 2.13.5) -->
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-core</artifactId>
				<version>2.18.8</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>2.18.9</version>
			</dependency>
			<!-- Logback overrides (spring-boot-dependencies 2.7.18 manages 1.2.12) -->
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-core</artifactId>
				<version>1.5.34</version>
			</dependency>
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-classic</artifactId>
				<version>1.5.34</version>
			</dependency>
			<!-- Apache Santuario XML Security -->
			<dependency>
				<groupId>org.apache.santuario</groupId>
				<artifactId>xmlsec</artifactId>
				<version>2.2.6</version>
			</dependency>
			<!-- Plexus Archiver -->
			<dependency>
				<groupId>org.codehaus.plexus</groupId>
				<artifactId>plexus-archiver</artifactId>
				<version>4.8.0</version>
			</dependency>
			<!-- Plexus Utils -->
			<dependency>
				<groupId>org.codehaus.plexus</groupId>
				<artifactId>plexus-utils</artifactId>
				<version>3.6.1</version>
			</dependency>
			<!-- TuxCare commons-httpclient backport -->
			<dependency>
				<groupId>commons-httpclient</groupId>
				<artifactId>commons-httpclient</artifactId>
				<version>3.1.tuxcare.1</version>
			</dependency>
			<!-- org.apache.sling.api: transitive via maven-sling-plugin →
			     org.apache.sling.commons.osgi → org.apache.sling.api 2.0.2-incubator.
			     Fixes CVE-2013-2254 (patched 2.4.0) and CVE-2015-2944 (patched 2.2.2). -->
			<dependency>
				<groupId>org.apache.sling</groupId>
				<artifactId>org.apache.sling.api</artifactId>
				<version>2.4.0</version>
			</dependency>
			<!-- junit: pin to 4.13.2 to override any transitive 4.12 resolution.
			     Fixes CVE-2020-15250. -->
			<dependency>
				<groupId>junit</groupId>
				<artifactId>junit</artifactId>
				<version>4.13.2</version>
			</dependency>
			<!-- commons-compress: transitive via plexus-archiver 4.8.0 (declares 1.23.0).
			     Fixes CVE-2023-42503 (patched 1.24.0), CVE-2024-25710 and
			     CVE-2024-26308 (both patched 1.26.0). -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>1.26.0</version>
			</dependency>
			<!-- snappy: transitive via plexus-archiver 4.8.0 (declares 0.4).
			     Fixes CVE-2024-36124 (patched 0.5). -->
			<dependency>
				<groupId>org.iq80.snappy</groupId>
				<artifactId>snappy</artifactId>
				<version>0.5</version>
			</dependency>
			<!-- protobuf-java: transitive via mysql-connector-java 8.0.28 (declares 3.11.4).
			     Fixes CVE-2021-22569 (patched 3.16.1), CVE-2022-3171/3509/3510
			     (patched 3.16.3), CVE-2024-7254 (patched 3.25.5). -->
			<dependency>
				<groupId>com.google.protobuf</groupId>
				<artifactId>protobuf-java</artifactId>
				<version>3.25.5</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<repositories>
		<repository>
			<id>aikido-maven</id>
			<url>https://maven.aikido.io/b6b7219dae019f5710c</url>
		</repository>
	</repositories>

	<build>
		<finalName>verademo</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<debug>true</debug>
					<debuglevel>lines,vars,source</debuglevel>
					<compilerargs>
						<arg>-g:source,lines,vars</arg>
					</compilerargs>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
